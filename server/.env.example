# Copy to .env and adjust as needed. Values here are the defaults baked
# into app/core/config.py; you only need this file to override them.

STORAGE_DIR=/data/storage
JOB_TTL_HOURS=6
CLEANUP_INTERVAL_SECONDS=900

MAX_CONCURRENT_DOWNLOADS=2
MAX_CONCURRENT_RENDERS=2
MAX_SOURCE_FILESIZE_MB=80

# Comma-separated list is NOT supported directly by pydantic-settings for a
# tuple env var without a parser; leave this at its code default unless you
# also adjust app/core/config.py's Settings.allowed_hosts.
# ALLOWED_HOSTS=tiktok.com,www.tiktok.com,vm.tiktok.com,vt.tiktok.com

RATE_LIMIT_PER_HOUR=60

DOWNLOAD_TIMEOUT_SECONDS=120
FFMPEG_TIMEOUT_SECONDS=60

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
