# Copy to .env and adjust as needed. Values here are the defaults baked
# into internal/config/config.go; you only need this file to override them.

STORAGE_DIR=/data/storage
JOB_TTL_HOURS=6
CLEANUP_INTERVAL_SECONDS=900

# Bounded concurrency for downloads and ffmpeg renders.
MAX_CONCURRENT_DOWNLOADS=2
MAX_CONCURRENT_RENDERS=2
MAX_SOURCE_FILESIZE_MB=80

# Comma-separated. Only these hosts are ever handed to the downloader.
# ALLOWED_HOSTS=tiktok.com,www.tiktok.com,vm.tiktok.com,vt.tiktok.com

# Per device+IP. 0 disables the limit (fine for single-user local use).
RATE_LIMIT_PER_HOUR=60

# Base URL of the yt-dlp downloader service, and the cap for one download call.
DOWNLOADER_URL=http://downloader:8000
DOWNLOAD_TOTAL_TIMEOUT_SECONDS=300

# What fills the empty areas of the square canvas (letterbox bars): "blur" (opaque
# blurred copy of the video, cheaper in bytes so more fps fit) or "transparent".
PADDING_FILL=blur

# Per ffmpeg invocation. A render runs several (quality search).
FFMPEG_TIMEOUT_SECONDS=60

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
